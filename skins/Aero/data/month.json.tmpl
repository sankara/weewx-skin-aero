#errorCatcher Echo
## month.json.tmpl
{
  "meta": {
    "time": $current.dateTime.json,
    "startTimestamp": $month.start.raw,
    "endTimestamp": $month.end.raw
  },
  "observations": [
    {
      "observation": "outTemp",
      "min": $month.outTemp.min.json,
      "max": $month.outTemp.max.json,
      "unit": "$unit.label.outTemp",
      "graph": $month.outTemp.series(time_unit='unix_epoch', aggregate_interval=10800).json
    },
    {
      "observation": "rain",
      "sum": $month.rain.sum.json,
      "unit": "$unit.label.rain",
      "graph": $month.rain.series(time_unit='unix_epoch', aggregate_interval=10800).json
    }
  ]
}
