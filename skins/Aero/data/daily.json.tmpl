#errorCatcher Echo
## daily.json.tmpl
{
  "meta": {
    "time": $current.dateTime.raw
  },
  "observations": [
    {
      "observation": "outTemp",
      "min": $day.outTemp.min.raw,
      "max": $day.outTemp.max.raw,
      "unit": "$unit.label.outTemp",
      "graph": $day.outTemp.series(time_unit='unix_epoch', aggregate_interval=None).json
    },
    {
      "observation": "outHumidity",
      "min": $day.outHumidity.min.raw,
      "max": $day.outHumidity.max.raw,
      "unit": "$unit.label.outHumidity",
      "graph": $day.outHumidity.series(time_unit='unix_epoch', aggregate_interval=None).json
    },
    {
      "observation": "rain",
      "sum": $day.rain.sum.raw,
      "unit": "$unit.label.rain",
      "graph": $day.rain.series(time_unit='unix_epoch', aggregate_interval=None).json
    }
  ]
}
