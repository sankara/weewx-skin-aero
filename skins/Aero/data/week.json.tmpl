#errorCatcher Echo
## week.json.tmpl
{
  "meta": {
    "time": $current.dateTime.raw
  },
  "observations": [
    {
      "observation": "outTemp",
      "min": $week.outTemp.min.raw,
      "max": $week.outTemp.max.raw,
      "unit": "$unit.label.outTemp",
      "graph": $week.outTemp.series(time_unit='unix_epoch', aggregate_interval=3600).json
    },
    {
      "observation": "outHumidity",
      "min": $week.outHumidity.min.raw,
      "max": $week.outHumidity.max.raw,
      "unit": "$unit.label.outHumidity",
      "graph": $week.outHumidity.series(time_unit='unix_epoch', aggregate_interval=3600).json
    },
    {
      "observation": "barometer",
      "min": $week.barometer.min.raw,
      "max": $week.barometer.max.raw,
      "unit": "$unit.label.barometer",
      "graph": $week.barometer.series(time_unit='unix_epoch', aggregate_interval=3600).json
    },
    {
      "observation": "windSpeed",
      "min": $week.windSpeed.min.raw,
      "max": $week.windSpeed.max.raw,
      "unit": "$unit.label.windSpeed",
      "graph": $week.windSpeed.series(time_unit='unix_epoch', aggregate_interval=3600).json
    },
    {
      "observation": "rain",
      "sum": $week.rain.sum.raw,
      "unit": "$unit.label.rain",
      "graph": $week.rain.series(time_unit='unix_epoch', aggregate_interval=3600).json
    }
  ]
}
