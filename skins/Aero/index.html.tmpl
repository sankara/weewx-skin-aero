<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#e0eafc">
    <title>$station.location</title>
    <script>
        // Inline script to prevent FOUC
        (function() {
            try {
                var local = localStorage.getItem('theme');
                var sys = window.matchMedia('(prefers-color-scheme: dark)').matches;
                var meta = document.querySelector('meta[name="theme-color"]');
                if (local === 'dark' || (!local && sys)) {
                    document.documentElement.classList.add('dark');
                    if (meta) meta.setAttribute('content', '#0f172a');
                } else {
                    document.documentElement.classList.remove('dark');
                    if (meta) meta.setAttribute('content', '#e0eafc');
                }

                // Design
                 var design = localStorage.getItem('design'); // Stored as 'aero' or 'simple'
                 // Check checking specific class logic if needed, usually handled by css var overrides or specific class
                 if (design === 'aero') {
                     document.documentElement.classList.add('theme-aero');
                 }
            } catch (e) {}
        })();
    </script>
    <link rel="stylesheet" href="style.css">
    <!-- Chart.js from CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-adapter-date-fns"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
</head>

<body>
    <a href="#content-area" class="skip-link">Skip to main content</a>
    <div id="ptr-indicator" class="ptr-indicator">
        <i data-lucide="refresh-cw" class="ptr-icon"></i>
        <span class="ptr-text">Pull to refresh</span>
    </div>
    <div class="app-container">
        <!-- FIXED TOP SECTION: Current Conditions -->
        <section id="current-section" class="section-current">
            <header class="main-header">
                <div class="header-left">
                    <h1 id="station-title">$station.location</h1>
                    <span id="last-updated" class="subtitle">Updating...</span>
                </div>
                <div class="header-controls">
                    <!-- Settings Button -->
                    <button id="settings-btn" class="btn-icon" aria-label="Settings" title="Settings">
                        <i data-lucide="settings"></i>
                    </button>
                </div>
            </header>

            <!-- Dials Grid for Current Live Data -->
            <div class="history-section-header" style="margin-top: 2rem; margin-bottom: 1rem;">
                <h2 class="section-title">Current Observations</h2>
            </div>
            <div id="current-dials" class="dials-container">
                <!-- Dials injected here -->
            </div>
        </section>

        <!-- SCROLLABLE BOTTOM SECTION: History Explorer -->
        <section id="history-section" class="section-history">
            <nav class="history-nav">
                <!-- Title moved to content area -->
                <div class="nav-extra">
                    <i data-lucide="calendar" class="nav-icon"></i>
                    <select id="mobile-view-select" class="mobile-select" aria-label="Select time period">
                        <option value="day">Day</option>
                        <option value="week">Week</option>
                        <option value="month">Month</option>
                        <option value="year">Year</option>
                        <option value="forecast">Forecast</option>
                    </select>
                </div>
                <div class="nav-tabs">
                    <button class="nav-btn active" data-view="day">Day</button>
                    <button class="nav-btn" data-view="week">Week</button>
                    <button class="nav-btn" data-view="month">Month</button>
                    <button class="nav-btn" data-view="year">Year</button>
                    <button class="nav-btn" data-view="forecast">Forecast</button>
                </div>

                <div class="date-controls">
                    <button id="date-prev" class="date-btn" aria-label="Previous">
                        <i data-lucide="chevron-left"></i>
                    </button>
                    <span id="current-date-display">Today</span>
                    <button id="date-next" class="date-btn" aria-label="Next">
                        <i data-lucide="chevron-right"></i>
                    </button>
                </div>
            </nav>

            <main id="content-area">
                <div class="history-section-header" style="margin-bottom: 1rem;">
                     <h2 id="history-title" class="section-title">Summary</h2>
                </div>
                <!-- Summary of Selected History Period -->
                <div id="history-summary">
                    <!-- Summary Cards injected here -->
                </div>

                <!-- Graphs (Historical Data) -->
                <div id="graphs-container" class="graphs-section">
                    <!-- Graphs injected here -->
                </div>

                <!-- Forecast (Separate from Historical) -->
                <div id="forecast-container" class="forecast-section-wrapper" style="display: none;">
                    <!-- Forecast content injected here -->
                </div>
            </main>
        </section>
    </div>

    <!-- Settings Modal -->
    <div id="modal-overlay" class="modal-overlay hidden">
        <div id="settings-modal" class="modal">
            <header class="modal-header">
                <h2>Unit Settings</h2>
                <button id="close-modal-btn" class="btn-icon" aria-label="Close settings"><i data-lucide="x"></i></button>
            </header>

            <div class="modal-body">
                <p class="modal-desc">Select the unit you want to display for each measurement below.</p>

                <!-- Presets -->
                <div class="segment-control preset-control">
                    <button data-preset="imperial" class="segment-btn">IMPERIAL</button>
                    <button data-preset="metric" class="segment-btn">METRIC</button>
                    <button data-preset="custom" class="segment-btn disabled" disabled>CUSTOM</button>
                </div>

                <!-- Unit Toggles -->
                <div class="settings-list">
                    <div class="setting-item">
                        <span>TEMP</span>
                        <div class="segment-control-sm" data-type="temp">
                            <button data-val="°F">°F</button>
                            <button data-val="°C">°C</button>
                        </div>
                    </div>
                    <div class="setting-item">
                        <span>SPEED/WIND</span>
                        <div class="segment-control-sm" data-type="speed">
                            <button data-val="mph">MPH</button>
                            <button data-val="km/h">KM/H</button>
                            <button data-val="kts">KTS</button>
                            <button data-val="m/s">M/S</button>
                        </div>
                    </div>
                    <div class="setting-item">
                        <span>PRESSURE</span>
                        <div class="segment-control-sm" data-type="pressure">
                            <button data-val="inHg">IN</button>
                            <button data-val="hPa">MB</button>
                        </div>
                    </div>
                    <div class="setting-item">
                        <span>RAINFALL</span>
                        <div class="segment-control-sm" data-type="rain">
                            <button data-val="in">IN</button>
                            <button data-val="mm">MM</button>
                        </div>
                    </div>

                    <div class="divider"></div>

                    <div class="setting-item">
                        <span>THEME</span>
                        <div class="segment-control-sm" data-type="theme">
                            <button data-val="light">LIGHT</button>
                            <button data-val="dark">DARK</button>
                        </div>
                    </div>
                     <div class="setting-item">
                        <span>DESIGN</span>
                        <div class="segment-control-sm" data-type="design">
                            <button data-val="simple">SIMPLE</button>
                            <button data-val="aero">AERO</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script type="module" src="app.js"></script>
    <script>
        lucide.createIcons();
    </script>
</body>

</html>
